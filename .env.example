# SMTP Brevo (Paramètres → SMTP & API → onglet SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=ade621001@smtp-brevo.com
SMTP_PASS=
# Expéditeur : doit être une adresse ou un domaine validé dans Brevo (Expéditeurs, domaines et IP)
CONTACT_FROM=contact@diomoh.com
# Destinataire des messages du formulaire
CONTACT_TO=contact@diomoh.com

# En-tête contenant la vraie IP du visiteur (anti-spam du formulaire).
# Derrière Cloudflare : cf-connecting-ip. Sans Cloudflare : x-forwarded-for.
CLIENT_IP_HEADER=cf-connecting-ip
